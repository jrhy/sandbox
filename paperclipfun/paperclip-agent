#!/usr/bin/env bash
# Create a sandboxed Paperclip agent: its Claude config dir, a persistent fake
# HOME, and the Paperclip agent record pointing at paperclip-sb-claude.
#
#   paperclip-agent create <name> --role coder   --model <id> --cwd <worktree> [--budget <cents>]
#   paperclip-agent create <name> --role reviewer --model <id> --review <worktree> [--budget <cents>]
#
# coder:    cwd is an isolated worktree on an agent/ branch; may commit there.
# reviewer: cwd is a private scratch workspace; the reviewed worktree and the
#           main repo's .git are read-only. Cannot commit anywhere.

set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
[[ -f "${PAPERCLIPFUN_ENV:-$HOME/.config/paperclipfun/env}" ]] && . "${PAPERCLIPFUN_ENV:-$HOME/.config/paperclipfun/env}"

api="${PAPERCLIP_API_URL:-http://127.0.0.1:3100}"
agents_root="$HOME/.paperclip-claude/agents"
main_git="${PAPERCLIP_SB_GIT_COMMON:?set PAPERCLIP_SB_GIT_COMMON (the main repo .git dir)}"
wrapper="$here/paperclip-sb-claude"

die() { echo "paperclip-agent: $*" >&2; exit 1; }

# The company to act in: PAPERCLIP_COMPANY_ID, else the only company the server has.
company_id() {
  if [[ -n "${PAPERCLIP_COMPANY_ID:-}" ]]; then echo "$PAPERCLIP_COMPANY_ID"; return; fi
  local ids; ids=$(curl -sf "$api/api/companies" | jq -r '.[].id') || die "cannot reach $api"
  [[ -n $ids && $(wc -l <<<"$ids") -eq 1 ]] || die "set PAPERCLIP_COMPANY_ID; server has $(wc -l <<<"$ids" | tr -d ' ') companies"
  echo "$ids"
}

# Per-agent Claude config dir: the operator's client id, attribution off, deny
# rules as a second layer under the sandbox, a persistent HOME, a scratch cwd.
setup_config_dir() {
  local dir="$1" cwd="$2"
  mkdir -p "$dir/tmp" "$dir/home" "$cwd"
  if [[ ! -f $dir/.claude.json ]]; then
    # Same Claude client id as the operator's own install.
    jq '{userID, hasCompletedOnboarding: true}' "$HOME/.claude.json" >"$dir/.claude.json"
    chmod 600 "$dir/.claude.json"
  fi
  cat >"$dir/settings.json" <<'JSON'
{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "WebFetch", "WebSearch",
      "Read(~/.aws/**)", "Edit(~/.aws/**)",
      "Read(~/.ssh/**)", "Edit(~/.ssh/**)",
      "Read(~/.kube/**)", "Edit(~/.kube/**)",
      "Read(~/.config/**)", "Edit(~/.config/**)",
      "Read(~/.granted/**)", "Read(~/.docker/**)", "Read(~/.netrc)",
      "Read(~/.claude/**)", "Edit(~/.claude/**)", "Read(~/.claude.json)", "Edit(~/.claude.json)",
      "Edit(~/.paperclip-claude/**)", "Read(~/.paperclip/agent-jwt-secret)", "Edit(~/.paperclip/**)",
      "Edit(~/bin/**)", "Edit(MAIN_REPO/**)"
    ]
  }
}
JSON
  # The main checkout is agent-readable (through the worktree's git) but never writable.
  sed -i '' "s#MAIN_REPO#$(dirname "$main_git")#" "$dir/settings.json"
  prewarm_home "$dir"

}

# Tools that cache under $HOME get built on the host once, into the agent's
# persistent fake HOME, because the sandbox has no network to build them in.
prewarm_home() {
  local dir="$1" repo; repo=$(dirname "$main_git")
  ( cd "$repo" && HOME="$dir/home" bin/shzr check bin/worktree >/dev/null 2>&1 ) || true
  ( cd "$repo" && HOME="$dir/home" bin/promql --help >/dev/null 2>&1 ) || true
  ( cd "$repo" && HOME="$dir/home" bin/dashy --help >/dev/null 2>&1 ) || true
}

# Role-specific binding shared by create and bind: cwd, extra sb grants, env.
role_binding() {
  local role="$1" cwd="$2" review="$3" dir="$4"
  case "$role" in
    coder)
      [[ -d $cwd && -f $cwd/.git ]] || die "--cwd must be an existing linked worktree (has a .git file): $cwd"
      [[ -n "$(ls -A "$cwd" | grep -v '^\.git$')" ]] || die "--cwd is an empty checkout: $cwd"
      BIND_CWD="$cwd"; BIND_EXTRA="" ;;
    reviewer|verifier|simplifier)
      [[ -d $review ]] || die "--review must be an existing worktree"
      BIND_CWD="$dir/workspace"; BIND_EXTRA="--allow-read $review --allow-read $main_git" ;;
    observer)
      # Read-only investigator: the main checkout for bin/promql, zuul and the
      # skills docs; no worktree, no git write. Needs --tier to be useful.
      BIND_CWD="$dir/workspace"; BIND_EXTRA="--allow-read $(dirname "$main_git")" ;;
    *) die "role must be coder, reviewer, verifier, simplifier or observer" ;;
  esac
}

# One "## <title>" section of a markdown file, header excluded, up to the next "## ".
obs_section() {
  awk -v want="## $2" 'f && /^## /{exit} f{print} $0==want{f=1}' "$1"
}

# Body of the team package's AGENTS.md for a role, without the frontmatter.
role_instructions() {
  local f="$here/team/agents/$1/AGENTS.md" tiers="${2:-}" gw="${3:-}"
  [[ -f $f ]] || die "no instructions for role $1 at $f"
  awk 'f==2{print} /^---$/{f++}' "$f" | sed '1{/^$/d;}'
  if [[ -n $tiers ]]; then
    local obs="$here/team/observability.md"
    printf '\n## Observability (granted tiers: %s)\n' "$tiers"
    obs_section "$obs" "Shared"
    for t in ${tiers//,/ }; do obs_section "$obs" "Tier: $t"; done
    [[ $gw == dev ]] && obs_section "$obs" "Grafana writes (dev)"
  fi
  return 0
}

cmd_create() {
  local name="" role="" model="" cwd="" review="" budget=500 tiers="" gw=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role) role="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --review) review="$2"; shift 2 ;;
      --budget) budget="$2"; shift 2 ;;
      --tier) tiers="$2"; shift 2 ;;
      --grafana-write) gw="$2"; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n $name && -n $role && -n $model ]] || die "need <name> --role --model"

  local dir="$agents_root/$name"
  [[ -e $dir ]] && die "agent config dir exists: $dir (use bind to re-point an existing agent)"
  role_binding "$role" "$cwd" "$review" "$dir"
  cwd="$BIND_CWD"; local extra="$BIND_EXTRA"
  setup_config_dir "$dir" "$cwd"

  local env
  env=$(jq -n --arg d "$dir" --arg x "$extra" --arg t "$tiers" --arg g "$gw" '
    {CLAUDE_CONFIG_DIR: {type:"plain", value:$d}}
    + (if $x == "" then {} else {PAPERCLIP_SB_EXTRA_ARGS: {type:"plain", value:$x}} end)
    + (if $t == "" then {} else {PAPERCLIP_SB_TIERS: {type:"plain", value:$t}} end)
    + (if $g == "" then {} else {PAPERCLIP_SB_GRAFANA_WRITE: {type:"plain", value:$g}} end)')
  local body company; company=$(company_id)
  body=$(jq -n --arg n "$name" --arg t "$role" --arg m "$model" --arg c "$cwd" --arg w "$wrapper" \
    --argjson b "$budget" --argjson e "$env" '{
      name:$n, role:"general", title:$t, adapterType:"claude_local", budgetMonthlyCents:$b,
      adapterConfig:{model:$m, engine:"cli", command:$w, cwd:$c, env:$e}}')
  local created id
  created=$(curl -sf -X POST "$api/api/companies/$company/agents" -H 'content-type: application/json' -d "$body")
  id=$(jq -r .id <<<"$created")
  write_role_instructions "$id" "$role" "$name" "$tiers" "$gw"
  jq -r '"created \(.name) id=\(.id) model=\(.adapterConfig.model) cwd=\(.adapterConfig.cwd)"' <<<"$created"
}

# Replace an agent's managed AGENTS.md with the team package's role instructions.
# The entry file is written with optimistic concurrency: read its current
# revision id (null when there is none yet) and send it back.
write_role_instructions() {
  local id="$1" role="$2" name="$3" tiers="${4:-}" gw="${5:-}" base
  base=$(curl -sf "$api/api/agents/$id/instructions-bundle/file?path=AGENTS.md" | jq -c '.revision.id // null')
  curl -sf -X PUT "$api/api/agents/$id/instructions-bundle/file" -H 'content-type: application/json' \
    -d "$(jq -n --arg c "$(role_instructions "$role" "$tiers" "$gw")" --argjson b "${base:-null}" '{path:"AGENTS.md", content:$c, baseRevisionId:$b}')" >/dev/null \
    || die "could not write instructions for $name"
}

# Copy an agent worktree's private objects into the main repo through
# index-pack --strict, so every object is re-hashed and fsck'd before host git
# can read it. Run this before `git log agent/<name>` on the host.
cmd_import() {
  local wt="$1" admin ids
  [[ -d $wt ]] || die "no such worktree: $wt"
  admin="$main_git/worktrees/$(basename "$wt")"
  [[ -d $admin/objects ]] || { echo "nothing to import"; return 0; }
  ids=$(cd "$admin/objects" && {
    for f in [0-9a-f][0-9a-f]/*; do [[ -f $f ]] && echo "${f%%/*}${f#*/}"; done
    for i in pack/*.idx; do [[ -f $i ]] && git show-index <"$i" | awk '{print $2}'; done
  } | grep -E '^[0-9a-f]{40}$|^[0-9a-f]{64}$' | sort -u || true)
  [[ -n $ids ]] || { echo "nothing to import"; return 0; }
  printf '%s\n' "$ids" \
    | GIT_DIR="$main_git" GIT_ALTERNATE_OBJECT_DIRECTORIES="$admin/objects" git pack-objects --stdout -q \
    | GIT_DIR="$main_git" git index-pack --strict --stdin >/dev/null
  echo "imported $(printf '%s\n' "$ids" | wc -l | tr -d ' ') objects from $(basename "$wt")"
}

# One-time setup checks, plus the two things the Paperclip onboarding wizard
# can't do with a proxy token: create the company, and (via paperclip-proxy) the
# agent JWT secret.
cmd_bootstrap() {
  local name="${1:-}" ok=true t
  for t in node pnpm claude sb jq curl git; do
    command -v "$t" >/dev/null || { echo "missing: $t" >&2; ok=false; }
  done
  # Paperclip's native runner is a Rust build; rustup's keg-only prefix is a common home.
  command -v cargo >/dev/null || [[ -x /opt/homebrew/opt/rustup/bin/cargo ]] \
    || { echo "missing: cargo (brew install rustup; rustup default stable; add /opt/homebrew/opt/rustup/bin to PATH)" >&2; ok=false; }
  [[ -d "${PAPERCLIP_SRC:-$HOME/src/paperclip}/node_modules" ]] || { echo "missing: pnpm install in ${PAPERCLIP_SRC:-$HOME/src/paperclip}" >&2; ok=false; }
  [[ -f "$HOME/.claude.json" ]] || { echo "missing: ~/.claude.json (run claude once)" >&2; ok=false; }
  (sb exec -h 2>&1 || true) | grep -q allow-write || { echo "sb exec lacks --allow-write; rebuild from ~/sandbox/cmd/sb" >&2; ok=false; }
  [[ -d $main_git ]] || { echo "PAPERCLIP_SB_GIT_COMMON is not a dir: $main_git" >&2; ok=false; }
  $ok || exit 1
  curl -sf "$api/api/health" >/dev/null || die "Paperclip is not running at $api (start paperclip-proxy)"
  if [[ -n $name ]]; then
    curl -sf -X POST "$api/api/companies" -H 'content-type: application/json' \
      -d "$(jq -n --arg n "$name" '{name:$n}')" | jq -r '"created company \(.name) id=\(.id)  (export PAPERCLIP_COMPANY_ID=\(.id))"'
  else
    echo "companies: $(curl -sf "$api/api/companies" | jq -r '.[] | "\(.name)=\(.id)"' | tr '\n' ' ')"
  fi
  echo "ok"
}

# Re-point an existing Paperclip agent at a role from the team package: its
# instructions become the role's AGENTS.md, and cwd/grants/env bind it to a
# worktree. Use after `paperclipai company import team/` or to move an agent.
cmd_bind() {
  local name="" role="" model="" cwd="" review="" budget="" tiers="" gw=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role) role="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --review) review="$2"; shift 2 ;;
      --budget) budget="$2"; shift 2 ;;
      --tier) tiers="$2"; shift 2 ;;
      --grafana-write) gw="$2"; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n $name && -n $role ]] || die "need <name> --role coder|reviewer|verifier|simplifier|observer (--cwd <wt> | --review <wt>)"
  local company id; company=$(company_id)
  id=$(curl -sf "$api/api/companies/$company/agents" | jq -r --arg n "$name" '.[] | select(.name==$n) | .id')
  [[ -n $id && $(wc -l <<<"$id") -eq 1 ]] || die "no single agent named $name"

  local dir="$agents_root/$name"
  role_binding "$role" "$cwd" "$review" "$dir"
  setup_config_dir "$dir" "$BIND_CWD"

  local env patch
  env=$(jq -n --arg d "$dir" --arg x "$BIND_EXTRA" --arg t "$tiers" --arg g "$gw" '
    {CLAUDE_CONFIG_DIR: {type:"plain", value:$d}}
    + (if $x == "" then {} else {PAPERCLIP_SB_EXTRA_ARGS: {type:"plain", value:$x}} end)
    + (if $t == "" then {} else {PAPERCLIP_SB_TIERS: {type:"plain", value:$t}} end)
    + (if $g == "" then {} else {PAPERCLIP_SB_GRAFANA_WRITE: {type:"plain", value:$g}} end)')
  patch=$(curl -sf "$api/api/agents/$id" | jq --arg c "$BIND_CWD" --arg w "$wrapper" --arg m "$model" \
    --arg t "$role" --argjson e "$env" --arg b "$budget" '{
      title: $t,
      adapterConfig: (.adapterConfig + {engine:"cli", command:$w, cwd:$c, env:$e}
                      + (if $m == "" then {} else {model:$m} end))
    } + (if $b == "" then {} else {budgetMonthlyCents: ($b|tonumber)} end)')
  curl -sf -X PATCH "$api/api/agents/$id" -H 'content-type: application/json' -d "$patch" >/dev/null
  write_role_instructions "$id" "$role" "$name" "$tiers" "$gw"
  curl -sf "$api/api/agents/$id" | jq -r '"bound \(.name): role=\(.title) model=\(.adapterConfig.model) cwd=\(.adapterConfig.cwd)"'
}

# Read-only views for operators and other sessions.
cmd_agents() {
  local company; company=$(company_id)
  curl -sf "$api/api/companies/$company/agents" \
    | jq -r '.[] | [.name, .title, .status, (.adapterConfig.model // "-"), (.adapterConfig.cwd // "-")] | @tsv' | column -t -s $'\t'
}
cmd_issues() {
  local company; company=$(company_id)
  local agents; agents=$(curl -sf "$api/api/companies/$company/agents" | jq 'map({key:.id, value:.name}) | from_entries')
  curl -sf "$api/api/companies/$company/issues" \
    | jq -r --argjson a "$agents" 'sort_by(.identifier | ltrimstr("ZIP-") | tonumber) | .[] | [.identifier, .status, ($a[.assigneeAgentId // ""] // "-"), .title] | @tsv' | column -t -s $'\t'
}

# File an issue. Body comes from a file (or stdin with -), so other sessions can
# write a proper outcome/context/constraints description without quoting pain.
#   paperclip-agent file --title "..." --body-file issue.md [--assign <agent>] [--status backlog|todo]
# Unassigned or backlog issues never wake an agent; assigned todo issues do.
cmd_file() {
  local title="" body_file="" assign="" status="backlog"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      --assign) assign="$2"; shift 2 ;;
      --status) status="$2"; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) die "unexpected argument $1" ;;
    esac
  done
  [[ -n $title && -n $body_file ]] || die "need --title and --body-file (use - for stdin)"
  [[ $status == backlog || $status == todo ]] || die "--status must be backlog or todo"
  local body; if [[ $body_file == - ]]; then body=$(cat); else body=$(cat "$body_file"); fi
  local company assignee=null; company=$(company_id)
  if [[ -n $assign ]]; then
    assignee=$(curl -sf "$api/api/companies/$company/agents" | jq --arg n "$assign" '[.[] | select(.name==$n)] | if length==1 then .[0].id else empty end')
    [[ -n $assignee ]] || die "no single agent named $assign (see: paperclip-agent agents)"
    [[ $status == todo ]] || status=todo
  fi
  curl -sf -X POST "$api/api/companies/$company/issues" -H 'content-type: application/json' \
    -d "$(jq -n --arg t "$title" --arg d "$body" --argjson a "$assignee" --arg s "$status" '{title:$t, description:$d, assigneeAgentId:$a, status:$s}')" \
    | jq -r '"filed \(.identifier) \(.status)\(if .assigneeAgentId then " -> assigned" else " (unassigned; nothing will run)" end)"'
}

case "${1:-}" in
  agents) shift; cmd_agents "$@" ;;
  issues) shift; cmd_issues "$@" ;;
  file) shift; cmd_file "$@" ;;
  bind) shift; cmd_bind "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  create) shift; cmd_create "$@" ;;
  import) shift; cmd_import "$@" ;;
  *) echo "usage: paperclip-agent agents | issues
       paperclip-agent file --title <t> --body-file <f|-> [--assign <agent>] [--status backlog|todo]
       paperclip-agent bootstrap [<company name>]
       paperclip-agent create <name> --role coder|reviewer|verifier|simplifier|observer --model <id> (--cwd <wt> | --review <wt>) [--budget <cents>]
       paperclip-agent bind <name> --role coder|reviewer|verifier|simplifier|observer (--cwd <wt> | --review <wt>) [--model <id>] [--budget <cents>] [--tier dev[,prod]] [--grafana-write dev]
       paperclip-agent import <worktree>" >&2; exit 1 ;;
esac
