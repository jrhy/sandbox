#!/usr/bin/env bash
# Run the claude CLI for a Paperclip agent inside `sb exec` (macOS seatbelt).
# Set as the claude_local adapter's `command` with engine "cli".
#
# The agent can write only its cwd (the workspace Paperclip chose) and its
# CLAUDE_CONFIG_DIR, read its own Paperclip instructions/runtime files, and
# reach only the LLM proxy over HTTP(S) plus the Paperclip API on localhost.

set -euo pipefail

[[ -f "${PAPERCLIPFUN_ENV:-$HOME/.config/paperclipfun/env}" ]] && . "${PAPERCLIPFUN_ENV:-$HOME/.config/paperclipfun/env}"

: "${CLAUDE_CONFIG_DIR:?paperclip-sb-claude: set CLAUDE_CONFIG_DIR in the agent env}"
: "${PAPERCLIP_COMPANY_ID:?paperclip-sb-claude: PAPERCLIP_COMPANY_ID not set by Paperclip}"
: "${PAPERCLIP_AGENT_ID:?paperclip-sb-claude: PAPERCLIP_AGENT_ID not set by Paperclip}"

instance="${PAPERCLIP_HOME:-$HOME/.paperclip}/instances/${PAPERCLIP_INSTANCE_ID:-default}"
company="$instance/companies/$PAPERCLIP_COMPANY_ID"
llm_host="${PAPERCLIP_SB_LLM_HOST:?set PAPERCLIP_SB_LLM_HOST}"

# Localhost ports the agent may dial directly: the Paperclip API(s).
ports=()
for url in "${PAPERCLIP_API_URL:-}" "${PAPERCLIP_RUNTIME_API_URL:-}"; do
  [[ "$url" =~ ^https?://(localhost|127\.0\.0\.1)(:([0-9]+))? ]] || continue
  ports+=("${BASH_REMATCH[3]:-80}")
done
[[ ${#ports[@]} -gt 0 ]] || ports=(3100)
port_list="$(IFS=,; echo "${ports[*]}")"

# Claude otherwise uses /tmp/claude-<uid>, which other Claude sessions share.
export CLAUDE_CODE_TMPDIR="$CLAUDE_CONFIG_DIR/tmp"
# zsh writes here-documents under $TMPPREFIX (default /tmp/zsh), not $TMPDIR.
export TMPPREFIX="$CLAUDE_CODE_TMPDIR/zsh"
mkdir -p "$CLAUDE_CODE_TMPDIR"

# A persistent fake HOME so caches under ~ (zuul go-run binaries, etc.)
# survive between runs. Pre-warm host-built tools by running them once from
# the agent's cwd with HOME pointed here, e.g. HOME=$agent_home bin/shzr check.
agent_home="$CLAUDE_CONFIG_DIR/home"
mkdir -p "$agent_home"

# macOS mktemp ignores $TMPDIR for bare templates and -t; see mktemp-shim.sh.
mkdir -p "$agent_home/bin"
cp "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/mktemp-shim.sh" "$agent_home/bin/mktemp"
chmod +x "$agent_home/bin/mktemp"
export PATH="$agent_home/bin:$PATH"

args=(--minimal-fs
  --home "$agent_home"
  --http-allow "$llm_host"
  --localhost-allow "$port_list"
  --allow-write "$CLAUDE_CONFIG_DIR")
for dir in "$company/agents/$PAPERCLIP_AGENT_ID" "$company/claude-prompt-cache"; do
  [[ -d "$dir" ]] && args+=(--allow-read "$dir")
done
# Paperclip creates the run's scratch dirs under the server's own TMPDIR,
# outside anything else granted here; it deletes them after the run.
for dir in "${PAPERCLIP_RUN_SCRATCH_DIR:-}" "${PAPERCLIP_TASK_SCRATCH_DIR:-}" "${PAPERCLIP_SCRATCH_DIR:-}"; do
  [[ -n "$dir" && -d "$dir" ]] && args+=(--allow-write "$dir")
done
# Homebrew's bin/ entries are symlinks into Cellar/, which sb only reaches if
# the whole prefix is readable. It holds installed software, no user data.
[[ -d /opt/homebrew ]] && args+=(--allow-read /opt/homebrew)

# Go: sb replaces HOME, so Go's defaults would point at an empty module cache
# and an unreadable toolchain. Share the host module cache and toolchain
# read-only, keep build cache and temp files per agent, and never download.
if command -v go >/dev/null; then
  goroot="$(go env GOROOT)"
  gomodcache="$(go env GOMODCACHE)"
  mkdir -p "$CLAUDE_CONFIG_DIR/go-cache" "$CLAUDE_CODE_TMPDIR/go"
  args+=(--allow-read "$goroot")
  [[ -d "$gomodcache" ]] && args+=(--allow-read "$gomodcache")
  export GOMODCACHE="$gomodcache" GOCACHE="$CLAUDE_CONFIG_DIR/go-cache" \
    GOTMPDIR="$CLAUDE_CODE_TMPDIR/go" GOPROXY=off GOTOOLCHAIN=local
fi

# Git, for a linked worktree whose branch is under refs/heads/agent/. The
# shared repo is read-only except for this worktree's own admin dir and the
# agent/ branch namespace (refs + reflogs). New objects go to a private store
# in the admin dir; the shared store is only read, through
# GIT_ALTERNATE_OBJECT_DIRECTORIES, because write access there would also let
# the agent delete existing objects and pack indexes. The main repo must NOT
# list the private store in its alternates: git trusts loose objects by file
# name, so an object the agent stores under a forged id would be served as
# genuine to every host git command for as long as the line exists. Host-side
# review goes through `paperclip-agent import <worktree>`, which re-hashes
# everything with index-pack --strict first. Hooks, config and every other
# branch stay read-only, so the agent can't plant a hook or move a ref that
# unsandboxed git would act on.
#
# Nothing here runs git in the worktree: its .git file and admin dir are
# agent-writable, and host git following them would execute agent-chosen
# config. Paths come from the trusted main repo, and HEAD is read as text.
common="${PAPERCLIP_SB_GIT_COMMON:?set PAPERCLIP_SB_GIT_COMMON (the main repo .git dir)}"
gitdir="$common/worktrees/$(basename "$PWD")"
if [[ -f .git && -f "$gitdir/HEAD" ]]; then
  branch="$(sed -n 's#^ref: refs/heads/##p' "$gitdir/HEAD")"
  if [[ "$branch" == agent/* ]]; then
    objdir="$gitdir/objects"
    mkdir -p "$common/refs/heads/agent" "$common/logs/refs/heads/agent" \
      "$objdir/pack" "$objdir/info"
    args+=(--allow-read "$common"
      --allow-write "$gitdir"
      --allow-write "$common/refs/heads/agent"
      --allow-write "$common/logs/refs/heads/agent")
    # The private store applies only to git run against this worktree. The shim
    # asks git which repository the command's target belongs to and applies the
    # store only when that is this worktree (its common dir is the main repo's).
    # init/clone create repos, so they never get it. A path-prefix test was tried
    # first and misfired on throwaway repos created from the worktree's cwd.
    cat >"$agent_home/bin/git" <<SH
#!/bin/bash
# Real git: first PATH entry other than this shim's dir that the sandbox can run.
real_git=\$(PATH=\${PATH//$agent_home\/bin:/} type -P git)
common='$common'
target=\$PWD
args=("\$@")
skip=
while [[ \${#args[@]} -ge 1 ]]; do
  case \${args[0]} in
    -C) [[ \${#args[@]} -ge 2 ]] || break
        case \${args[1]} in /*) target=\${args[1]} ;; *) target=\$target/\${args[1]} ;; esac
        args=("\${args[@]:2}") ;;
    --git-dir|--git-dir=*|--work-tree|--work-tree=*) skip=1; break ;;
    -*) args=("\${args[@]:1}") ;;
    init|clone) skip=1; break ;;
    *) break ;;
  esac
done
if [[ -z \${GIT_DIR:-} && -z \$skip && -d \$target ]]; then
  tc=\$(cd "\$target" 2>/dev/null && "\$real_git" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  if [[ -n \$tc && \$(cd "\$tc" 2>/dev/null && pwd -P) == \$(cd "\$common" && pwd -P) ]]; then
    export GIT_OBJECT_DIRECTORY='$objdir' GIT_ALTERNATE_OBJECT_DIRECTORIES='$common/objects'
  fi
fi
exec "\$real_git" "\$@"
SH
    chmod +x "$agent_home/bin/git"
    # HOME is replaced, so ~/.gitconfig is out of reach: supply identity, and
    # keep git from spawning an fsmonitor daemon or auto-gc (which rewrites
    # packs and packed-refs outside the granted paths).
    name="$(cd / && git config --global user.name)" email="$(cd / && git config --global user.email)"
    export GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" \
      GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" \
      GIT_CONFIG_COUNT=3 \
      GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false \
      GIT_CONFIG_KEY_1=gc.auto GIT_CONFIG_VALUE_1=0 \
      GIT_CONFIG_KEY_2=maintenance.auto GIT_CONFIG_VALUE_2=false
  fi
fi

# Observability grants by tier. Thanos and Loki are read-only anonymous APIs;
# Grafana read is anonymous through WARP. Loki prod can carry PII: the role's
# instructions (team/observability.md) carry the aggregate-and-redact rule.
# EU prod is never granted.
if [[ -n "${PAPERCLIP_SB_TIERS:-}" ]]; then
  hosts=""
  IFS=, read -r -a tiers <<<"$PAPERCLIP_SB_TIERS"
  for tier in "${tiers[@]}"; do
    case "$tier" in
      dev)  hosts+="thanos.d1-dev-uw2.zipaws.com,loki.d1-dev-uw2.zipaws.com,grafana.monitoring--grafana.d1-dev-uw2.zipaws.com," ;;
      prod) hosts+="thanos.p1-prod-ue1.zipaws.com,loki.p1-prod-ue1.zipaws.com,grafana.monitoring--grafana.p1-prod-ue1.zipaws.com," ;;
      *) echo "paperclip-sb-claude: unknown tier '$tier' in PAPERCLIP_SB_TIERS" >&2; exit 1 ;;
    esac
  done
  args+=(--http-allow "${hosts%,}")
  export LOKI_ORG_ID="${LOKI_ORG_ID:-logs--vector-agent}"
  # logcli ignores HTTP_PROXY unless asked; without this every Loki call fails
  # DNS inside the sandbox, whose only network path is the allowlist proxy.
  export LOKI_ENV_PROXY=true
fi

# Grafana dashboard writes, dev only. The cloudflared access token is read on
# the host and passed as an env value; the token file itself stays unreadable.
# The token acts as the operator, so the role's instructions limit writes to
# the personal preview dashboard; that limit is not enforceable here.
if [[ "${PAPERCLIP_SB_GRAFANA_WRITE:-}" == dev ]]; then
  tok=""
  for f in "$HOME"/.cloudflared/*.d1.zr.org-*-token; do
    [[ -f $f ]] || continue
    exp=$(python3 -c 'import sys,json,base64;t=open(sys.argv[1]).read().strip().split(".");print(json.loads(base64.urlsafe_b64decode(t[1]+"=="))["exp"])' "$f" 2>/dev/null) || continue
    (( exp > $(date +%s) + 600 )) && tok=$(<"$f")
  done
  if [[ -z $tok ]]; then
    echo "paperclip-sb-claude: no valid cloudflared token for grafana.d1.zr.org; run: bin/cloudflared access login https://grafana.d1.zr.org" >&2
    exit 1
  fi
  export GRAFANA_DEV_CF_TOKEN="$tok"
  args+=(--http-allow grafana.d1.zr.org)
fi

# Per-role extras, set in the agent's env config (e.g. a reviewer's
# --allow-read on the worktree it reviews). Whitespace-separated sb exec flags.
if [[ -n "${PAPERCLIP_SB_EXTRA_ARGS:-}" ]]; then
  read -r -a extra <<<"$PAPERCLIP_SB_EXTRA_ARGS"
  args+=("${extra[@]}")
fi

exec sb exec "${args[@]}" "${PAPERCLIP_SB_CLAUDE_BIN:-$HOME/.local/bin/claude}" "$@"
