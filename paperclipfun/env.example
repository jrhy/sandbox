# Copy to ~/.config/paperclipfun/env and edit. Sourced by paperclip-proxy,
# paperclip-sb-claude and paperclip-agent.

# Required: hostname of the Anthropic-compatible LLM proxy agents may reach.
PAPERCLIP_SB_LLM_HOST=llm-proxy.example.internal
# Optional: full base URL if it is not http://$PAPERCLIP_SB_LLM_HOST/anthropic
#PAPERCLIP_SB_LLM_BASE_URL=https://llm-proxy.example.internal/anthropic

# Required: the main checkout's .git dir. Agent worktrees are linked worktrees of it.
PAPERCLIP_SB_GIT_COMMON=$HOME/ziprecruiter/.git

# Command that prints a bearer token for the proxy. Default mints a ZR gateway key
# from the monorepo (needs ZR_REPO, ZR_LLM_AWS_PROFILE); any command works.
#PAPERCLIP_KEY_CMD='cat ~/.config/paperclipfun/token'
#ZR_REPO=$HOME/ziprecruiter
#ZR_LLM_AWS_PROFILE=dev/developers-dev

# Optional: Paperclip source checkout (default ~/src/paperclip) and API URL.
#PAPERCLIP_SRC=$HOME/src/paperclip
#PAPERCLIP_API_URL=http://127.0.0.1:3100
# Optional once more than one company exists.
#PAPERCLIP_COMPANY_ID=
